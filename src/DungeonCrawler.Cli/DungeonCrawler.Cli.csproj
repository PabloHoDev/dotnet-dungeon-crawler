<Project Sdk="Microsoft.NET.Sdk">

  <!-- Terminal presentation layer. Unlike the core, it is never compiled by Unity,
       so it targets modern .NET (see ADR-0004). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>dungeon-crawler</AssemblyName>
    <RootNamespace>DungeonCrawler.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DungeonCrawler.Domain\DungeonCrawler.Domain.csproj" />
    <ProjectReference Include="..\DungeonCrawler.Application\DungeonCrawler.Application.csproj" />
    <ProjectReference Include="..\DungeonCrawler.Infrastructure\DungeonCrawler.Infrastructure.csproj" />
  </ItemGroup>

</Project>
